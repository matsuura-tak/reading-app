    "h32IntentsReadout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invocations",
        "registeredShortcuts",
        "registeredControls"
      ],
      "description": "要素 hook.intents の JSON 出力スキーマ（H32。AC-114〜AC-126、AC-131〜AC-135、AC-143）。",
      "properties": {
        "invocations": {
          "type": "array",
          "description": "動かしたインテントの実行結果の履歴。",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "seq",
              "at",
              "intent",
              "authenticationPolicy",
              "opensApp",
              "requestedForeground",
              "outcome",
              "dialogKey",
              "spokenText",
              "snippetTexts"
            ],
            "properties": {
              "seq": {
                "type": "integer",
                "minimum": 1
              },
              "at": {
                "type": "string",
                "format": "date-time"
              },
              "intent": {
                "enum": [
                  "StartReadingIntent",
                  "EndReadingIntent",
                  "WhereStoppedIntent",
                  "ContinueReadingIntent"
                ],
                "description": "「読み始める」（StartReadingIntent）、「終える」（EndReadingIntent）、「どこまで読んだ？」（WhereStoppedIntent）、「続きを読む」（ContinueReadingIntent）。"
              },
              "authenticationPolicy": {
                "enum": [
                  "alwaysAllowed",
                  "requiresAuthentication"
                ],
                "description": "インテントの認証ポリシー（「どこまで読んだ？」は alwaysAllowed。AC-121、AC-123）。"
              },
              "opensApp": {
                "type": "boolean",
                "description": "インテントの結果が「アプリを前に出す」かどうか（AC-114、AC-116〜AC-118、AC-121、AC-124、AC-131、AC-134、AC-135）。"
              },
              "requestedForeground": {
                "type": "boolean",
                "description": "実際に前面に出す要求（requestToContinueInForeground / openAppWhenRun）を行ったか（canContinueInForeground が偽のときは false。AC-116(2)、AC-118(2)）。"
              },
              "outcome": {
                "enum": [
                  "succeeded",
                  "error"
                ]
              },
              "dialogKey": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "返した声の文言キー（例：intent.start.started、intent.start.alreadyReading、session.start.error、intent.whereStopped.page、intent.whereStopped.location、intent.whereStopped.percent、intent.whereStopped.noPage、intent.whereStopped.noCurrent、intent.whereStopped.error）。"
              },
              "spokenText": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "声の全文（「どこまで読んだ？」では一行、書名、アプリ名を含まない。AC-121〜AC-123、AC-133、AC-143）。"
              },
              "snippetTexts": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "小窓（Snippet View）に出した文字列の一覧（hideOnWidgets がオンまたはエラー時は一行と書名を含まない。小窓を出さない場合は空配列 []。AC-121、AC-123、AC-133）。"
              }
            }
          }
        },
        "registeredShortcuts": {
          "type": "array",
          "description": "AppShortcutsProvider に登録された App Shortcuts の一覧（ちょうど3つ：読み始める、どこまで読んだ？、続きを読む。AC-126）。",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "intent",
              "phrases",
              "systemImageName"
            ],
            "properties": {
              "intent": {
                "enum": [
                  "StartReadingIntent",
                  "WhereStoppedIntent",
                  "ContinueReadingIntent"
                ]
              },
              "phrases": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "description": "登録された言い方（すべてに ${applicationName} を含み、直後に「で」が続かないこと。AC-126）。"
              },
              "systemImageName": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "registeredControls": {
          "type": "array",
          "description": "ControlWidget として登録された Control の一覧（ちょうど1つ：ボタン、StartReadingIntent、control.startReading。AC-126）。",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "intent",
              "labelKey"
            ],
            "properties": {
              "kind": {
                "const": "button"
              },
              "intent": {
                "const": "StartReadingIntent"
              },
              "labelKey": {
                "const": "control.startReading"
              }
            }
          }
        }
      }
    }
