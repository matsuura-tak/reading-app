{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reading-app:contracts:hooks:h20-ndl-stub:1",
  "title": "H20 書誌の問い合わせの差し替え（環境変数 UITEST_NDL_STUB の JSON）大きな版 1",
  "description": "国立国会図書館サーチの GET /api/opensearch（contracts/ndl-opensearch.yaml の ndlOpenSearch）への応答を差し替える。要素の名前は国立国会図書館のまま（PRD 11 の冒頭）。つなぎ口はこの JSON から、本物と同じ名前空間の RSS 2.0 の XML を組んで返すので、アプリの XMLParser の読み方もそのまま通る。差し替えはアプリの通信の部品の一番下（送る直前）に入るので、差し替えた問い合わせも H29 に記録される。関係：contracts/test-hooks.md、ADR 0005、PRD 11 の冒頭のつなぎ口、設計メモ 5。書いた役：tech-lead、2026-10-20（G1 の 7-4a）。\n\n[合わせ方] 問い合わせの isbn か title の値（アプリが送った値そのもの）が match と同じ rules を前から探し、最初に合ったものを使う。responses は前から1つずつ使い、最後の1つはそのあと何回でも使う。どれにも合わなければ unmatched（省けば zero）。\n\n[応答の種類] items：HTTP 200、item をその順で入れる（openSearch:totalResults は totalResults か items の数）。zero：HTTP 200 で item なし。paramError：国立国会図書館が引数の誤りに返す形と同じ HTTP 200 の0件（ndl-opensearch.yaml の ParamError の例）。http：その HTTP の状態と短い HTML。\n\n[版] 同じ大きな版の中では、省ける項目と enum の値を足すことだけをする（名前、型、意味、範囲を変えない。必須を足さない）。選択肢（(5)、課金、ショートカットほか）を残すときに足す値は contracts/test-hooks.md の 4 に書く。",
  "type": "object",
  "required": [
    "stubVersion",
    "rules"
  ],
  "additionalProperties": false,
  "properties": {
    "stubVersion": {
      "const": 1
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "unmatched": {
      "$ref": "#/$defs/response",
      "description": "どの rules にも合わないときの応答。省けば zero。"
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "required": [
        "match",
        "responses"
      ],
      "additionalProperties": false,
      "properties": {
        "match": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "isbn"
              ],
              "additionalProperties": false,
              "properties": {
                "isbn": {
                  "type": "string",
                  "pattern": "^[0-9]{13}$"
                }
              }
            },
            {
              "type": "object",
              "required": [
                "title"
              ],
              "additionalProperties": false,
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        },
        "responses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/response"
          }
        }
      }
    },
    "response": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "items"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "items"
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 200,
              "items": {
                "$ref": "#/$defs/item"
              }
            },
            "totalResults": {
              "type": "integer",
              "minimum": 1
            },
            "hold": {
              "type": "boolean",
              "default": false,
              "description": "真なら、テストが Darwin の通知 yomuma.uitest.ndl.release を送るまで応答を止める（書誌を待つ間の画面を見るため。sleep で待たない）。"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "zero"
            },
            "hold": {
              "type": "boolean",
              "default": false,
              "description": "真なら、テストが Darwin の通知 yomuma.uitest.ndl.release を送るまで応答を止める（書誌を待つ間の画面を見るため。sleep で待たない）。"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "paramError"
            },
            "hold": {
              "type": "boolean",
              "default": false,
              "description": "真なら、テストが Darwin の通知 yomuma.uitest.ndl.release を送るまで応答を止める（書誌を待つ間の画面を見るため。sleep で待たない）。"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "status"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "http"
            },
            "status": {
              "type": "integer",
              "minimum": 400,
              "maximum": 599
            },
            "hold": {
              "type": "boolean",
              "default": false,
              "description": "真なら、テストが Darwin の通知 yomuma.uitest.ndl.release を送るまで応答を止める（書誌を待つ間の画面を見るため。sleep で待たない）。"
            }
          }
        }
      ]
    },
    "item": {
      "type": "object",
      "required": [
        "dc:title"
      ],
      "additionalProperties": false,
      "description": "item の子の要素。並びは XML の出る順。書かない要素は XML に出さない。",
      "properties": {
        "dc:title": {
          "type": "string",
          "minLength": 1
        },
        "dcndl:volume": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "巻。アプリは1つ目を書名の後ろに足す（ndl-opensearch.yaml の対応表）。"
        },
        "author": {
          "type": "string",
          "minLength": 1,
          "description": "RSS の author 要素（dc:creator がないときに使う。AC-92）。"
        },
        "dc:creator": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "dc:publisher": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "dcndl:seriesTitle": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "dcterms:issued": {
          "type": "string",
          "minLength": 1
        },
        "dc:identifier": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "xsi:type",
              "value"
            ],
            "additionalProperties": false,
            "properties": {
              "xsi:type": {
                "enum": [
                  "dcndl:ISBN",
                  "dcndl:ISBN13",
                  "dcndl:NDLBibID",
                  "dcndl:JPNO"
                ]
              },
              "value": {
                "type": "string",
                "pattern": "^[0-9Xx-]{1,20}$",
                "description": "書かれたままの値。10桁（ハイフンつき）も、dcndl:ISBN13 の中の10桁も書ける。"
              }
            }
          }
        }
      }
    }
  },
  "examples": [
    {
      "stubVersion": 1,
      "rules": [
        {
          "match": {
            "isbn": "9784101000015"
          },
          "responses": [
            {
              "kind": "items",
              "items": [
                {
                  "dc:title": "羅生門",
                  "dcndl:volume": [
                    "上"
                  ],
                  "author": "芥川, 龍之介, 1892-1927,芥川龍之介 著",
                  "dc:creator": [
                    "芥川, 龍之介, 1892-1927"
                  ],
                  "dc:publisher": [
                    "新潮社"
                  ],
                  "dcndl:seriesTitle": [
                    "新潮文庫 ; あ-1-1"
                  ],
                  "dcterms:issued": "2005.10",
                  "dc:identifier": [
                    {
                      "xsi:type": "dcndl:ISBN",
                      "value": "4-10-100001-8"
                    },
                    {
                      "xsi:type": "dcndl:ISBN13",
                      "value": "4-10-100001-8"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "match": {
            "isbn": "9784087000023"
          },
          "responses": [
            {
              "kind": "zero"
            }
          ]
        },
        {
          "match": {
            "isbn": "9791000000039"
          },
          "responses": [
            {
              "kind": "http",
              "status": 503
            },
            {
              "kind": "items",
              "items": [
                {
                  "dc:title": "楽譜の本",
                  "author": "中林くみこ 監修"
                }
              ]
            }
          ]
        },
        {
          "match": {
            "isbn": "9784000000048"
          },
          "responses": [
            {
              "kind": "paramError"
            }
          ]
        },
        {
          "match": {
            "title": "人間失格"
          },
          "responses": [
            {
              "kind": "items",
              "totalResults": 264,
              "hold": true,
              "items": [
                {
                  "dc:title": "人間失格",
                  "dc:creator": [
                    "太宰, 治, 1909-1948"
                  ],
                  "dc:publisher": [
                    "新潮社"
                  ],
                  "dcterms:issued": "2006.1",
                  "dc:identifier": [
                    {
                      "xsi:type": "dcndl:ISBN13",
                      "value": "978-4-10-100605-5"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "unmatched": {
        "kind": "zero"
      }
    },
    {
      "stubVersion": 1,
      "rules": []
    }
  ]
}
