{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://readingapp.local/contracts/widget-snapshot.schema.json",
  "title": "WidgetSnapshot",
  "description": "App Group 内の State/widget-snapshot.json に書き出され、ロック画面ウィジェット（W-1: accessoryRectangular）、ホーム画面・StandBy ウィジェット（W-2: systemSmall）、Live Activity（W-3）、および Siri『どこまで読んだ？』（W-5: WhereStoppedIntent）が読み取るスナップショット契約（AC-24〜34、AC-99、AC-106、AC-120〜123、AC-139、AC-141、AC-143）。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "hideOnWidgets",
    "appearanceID",
    "book"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1,
      "description": "スナップショットのスキーマ版番号（固定値 1）。"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "スナップショットを書き出した ISO 8601 UTC 日時。"
    },
    "hideOnWidgets": {
      "type": "boolean",
      "description": "S-10 の settings.hideOnWidgets がオンのとき true。true のとき W-1・W-2・W-3 には書名と一行を描画せず widget.hidden（『しおり』）と場所のみを表示する（AC-34、AC-41、AC-120）。"
    },
    "appearanceID": {
      "type": "string",
      "enum": ["default", "kinari", "sumi", "shu"],
      "description": "現在適用されている見た目 ID（AC-105、AC-106）。"
    },
    "book": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/WidgetBookSnapshot" }
      ],
      "description": "現在 status == 'current' の本。今の本が 0 冊のときは null（AC-31）。"
    }
  },
  "$defs": {
    "WidgetBookSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "author",
        "isEbook",
        "isTitlePending",
        "progressUnit",
        "page",
        "location",
        "percent",
        "lastLine"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "description": "今の本の UUID。"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "今の本の書名。isTitlePending == true のときは表示時に widget.currentBookAsTitle（『今の本』）を使う（AC-139）。"
        },
        "author": {
          "type": "string",
          "maxLength": 200,
          "description": "著者名（空文字列可）。"
        },
        "isEbook": {
          "type": "boolean",
          "description": "電子書籍のとき true（AC-141、AC-144）。"
        },
        "isTitlePending": {
          "type": "boolean",
          "description": "S-8 の register.later（あとで登録）で作られた名無しの本のとき true（AC-139、AC-140）。"
        },
        "progressUnit": {
          "type": "string",
          "enum": ["page", "location", "percent"],
          "description": "進み具合の単位（紙の本は常に page、電子書籍は page / location / percent、AC-141）。"
        },
        "page": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 9999,
          "description": "progressUnit == 'page' のときのページ番号（1〜9999）。未記録時は null。"
        },
        "location": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 999999,
          "description": "progressUnit == 'location' のときの位置番号（1〜999999、AC-141）。未記録時は null。"
        },
        "percent": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 100,
          "description": "progressUnit == 'percent' のときのパーセント値（0〜100、AC-141）。未記録時は null。"
        },
        "lastLine": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 60,
          "description": "最後に保存した一行（改行を空白に正規化済み、最大 60 文字）。未記録またはページ番号のみ保存時は null（AC-30、AC-53、AC-54）。"
        }
      }
    }
  },
  "examples": [
    {
      "schemaVersion": 1,
      "generatedAt": "2026-10-20T13:15:00Z",
      "hideOnWidgets": false,
      "appearanceID": "default",
      "book": {
        "id": "11111111-2222-4333-8444-555555555555",
        "title": "蜜蜂と遠雷",
        "author": "恩田 陸",
        "isEbook": false,
        "isTitlePending": false,
        "progressUnit": "page",
        "page": 61,
        "location": null,
        "percent": null,
        "lastLine": "世界はまだ、音楽で満ちていた。"
      }
    },
    {
      "schemaVersion": 1,
      "generatedAt": "2026-10-20T14:00:00Z",
      "hideOnWidgets": false,
      "appearanceID": "kinari",
      "book": {
        "id": "22222222-3333-4444-8555-666666666666",
        "title": "三体",
        "author": "劉 慈欣",
        "isEbook": true,
        "isTitlePending": false,
        "progressUnit": "location",
        "page": null,
        "location": 1450,
        "percent": null,
        "lastLine": "不要回答！"
      }
    },
    {
      "schemaVersion": 1,
      "generatedAt": "2026-10-20T15:00:00Z",
      "hideOnWidgets": false,
      "appearanceID": "default",
      "book": null
    }
  ]
}
