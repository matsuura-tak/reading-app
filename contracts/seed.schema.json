{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/yomutoki/contracts/seed.schema.json",
  "title": "UITEST_SEED（受け入れテストが起動のときに入れるデータ）",
  "description": "contracts/test-hooks.md の T2、T17。時刻はすべて UITEST_TIME_ZONE の壁時計（オフセットなし、秒まで）。JSON Schema で書けない制約は contracts/data-model.md の最後の節にあり、アプリが確かめる。",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "books"],
  "properties": {
    "version": { "const": 1 },
    "books": { "type": "array", "maxItems": 600, "items": { "$ref": "#/definitions/book" } },
    "sessions": { "type": "array", "maxItems": 12000, "items": { "$ref": "#/definitions/session" } },
    "active": { "oneOf": [ { "type": "null" }, { "$ref": "#/definitions/active" } ] },
    "flags": { "$ref": "#/definitions/flags" }
  },
  "definitions": {
    "wallClock": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$"
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "page": { "type": "integer", "minimum": 0, "maximum": 9999 },
    "book": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "totalPages", "lastPage", "addedAt"],
      "properties": {
        "id": { "$ref": "#/definitions/uuid" },
        "title": { "type": "string", "minLength": 1 },
        "totalPages": { "oneOf": [ { "type": "null" }, { "type": "integer", "minimum": 1, "maximum": 9999 } ] },
        "lastPage": { "$ref": "#/definitions/page" },
        "addedAt": { "$ref": "#/definitions/wallClock" }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "bookId", "startedAt", "durationSeconds", "endPage", "pagesRead", "savedAt"],
      "properties": {
        "id": { "$ref": "#/definitions/uuid" },
        "bookId": { "$ref": "#/definitions/uuid" },
        "startedAt": { "$ref": "#/definitions/wallClock" },
        "durationSeconds": { "type": "integer", "minimum": 60 },
        "endPage": { "oneOf": [ { "type": "null" }, { "$ref": "#/definitions/page" } ] },
        "pagesRead": { "oneOf": [ { "type": "null" }, { "$ref": "#/definitions/page" } ] },
        "savedAt": { "$ref": "#/definitions/wallClock" }
      },
      "if": { "properties": { "endPage": { "type": "null" } } },
      "then": { "properties": { "pagesRead": { "type": "null" } } },
      "else": { "properties": { "pagesRead": { "type": "integer" } } }
    },
    "active": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bookId", "state", "startedAt", "pausedTotalSeconds", "pausedAt", "finishedAt", "wasPaused"],
      "properties": {
        "bookId": { "$ref": "#/definitions/uuid" },
        "state": { "enum": ["reading", "paused", "finishing"] },
        "startedAt": { "$ref": "#/definitions/wallClock" },
        "pausedTotalSeconds": { "type": "number", "minimum": 0 },
        "pausedAt": { "oneOf": [ { "type": "null" }, { "$ref": "#/definitions/wallClock" } ] },
        "finishedAt": { "oneOf": [ { "type": "null" }, { "$ref": "#/definitions/wallClock" } ] },
        "wasPaused": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "paused" } } },
          "then": { "properties": { "pausedAt": { "$ref": "#/definitions/wallClock" }, "finishedAt": { "type": "null" }, "wasPaused": { "const": true } } }
        },
        {
          "if": { "properties": { "state": { "const": "finishing" } } },
          "then": { "properties": { "pausedAt": { "type": "null" }, "finishedAt": { "$ref": "#/definitions/wallClock" } } }
        },
        {
          "if": { "properties": { "state": { "const": "reading" } } },
          "then": { "properties": { "pausedAt": { "type": "null" }, "finishedAt": { "type": "null" } } }
        }
      ]
    },
    "flags": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "firstOpenedAt": { "oneOf": [ { "type": "null" }, { "$ref": "#/definitions/wallClock" } ] },
        "firstSessionStarted": { "type": "boolean" },
        "first5minDone": { "type": "boolean" },
        "weekReachedWeekStart": { "oneOf": [ { "type": "null" }, { "$ref": "#/definitions/wallClock" } ] }
      }
    }
  }
}
