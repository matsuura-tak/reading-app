# ai-org が最初に置いた .gitignore です。置いた後はこのアプリのもので、tech-lead が手入れします。

# 秘密情報（コミットしない。入れてしまったら鍵を作り直す）
.env
.env.*
!.env.example
.envrc
*.p8
*.p12
*.pem
*.key
*.mobileprovision
*.provisionprofile
*.keystore
*.jks
credentials.json
service-account*.json

# Claude Code の個人の設定
.claude/settings.local.json
.claude/worktrees/
CLAUDE.local.md

# Xcode / SwiftPM / ビルドの生成物
xcuserdata/
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/
*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/configuration
DerivedData/
build/
.build/
.swiftpm/
*.ipa
*.dSYM.zip
*.dSYM
*.xcresult
*.MovedAside
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
timeline.xctimeline
playground.xcworkspace

# その他（ツール・一時ファイル・OS）
node_modules/
__pycache__/
*.pyc
.venv/
.DS_Store
