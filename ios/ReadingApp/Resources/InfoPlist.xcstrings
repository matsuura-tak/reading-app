    },
    "NSCameraUsageDescription": {
      "comment": "カメラ権限の目的説明文（撮影した画像は文字とバーコードの読み取りにのみ使い保存しない旨を明記）",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本のバーコードや表紙・背表紙・奥付、および読み止めたページの文字をこの iPhone の中で読み取るためにカメラを使います。写真は保存せず、外部へ送信しません。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yomuma uses the camera to scan barcodes, covers, spines, colophons, and the line where you stopped on this iPhone. Photos are never saved or sent outside."
          }
        }
      }
    }
  }
}
