    },
    "CFBundleName": {
      "comment": "バンドル名",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "よむま"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yomuma"
          }
        }
