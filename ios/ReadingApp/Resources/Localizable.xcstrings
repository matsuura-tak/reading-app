        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Progress (0–100%)"
          }
        }
      }
    },
    "mark.line.label": {
      "comment": "引用一行の入力欄ラベル",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残す一行（140字まで）"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Line to Keep (up to 140 chars)"
          }
        }
      }
    },
    "mark.line.placeholder": {
      "comment": "引用一行の入力欄プレースホルダ",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "心に残った一行を、自分の言葉や引用で残せます"
