        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera Unavailable"
          }
        }
      }
    },
    "mark.camera.denied.body": {
      "comment": "カメラ権限拒否時の案内と手入力への誘導",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定アプリでカメラを許可するか、下の欄からページ番号と一行を手で入力してください"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow camera access in Settings, or type the page and line below"
          }
        }
      }
    },
    "mark.camera.openSettings": {
