    },
    "intent.start.noCurrent": {
      "comment": "W-5（「読み始める」で今の本が0冊のときの声の文。インテントの結果は「アプリを前に出す」で、前面は S-1。小窓は出さない。「よむまで」と続けない）。足した（2026-11-02、決定 84）。PRD（AC-117）",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今の本がありません。よむまを開きます。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There's no current book. Opening Yomuma."
          }
        }
      }
    },
    "intent.end.completed": {
      "comment": "W-5（Live Activity の「終える」で終わりを保存できたときの声の文。分数・場所・書名・一行は入れず、続きはアプリが前に出て S-3 で見せる。1分未満のときは `session.tooShort`、保存に失敗したときは `session.save.error` の文）。足した（2026-11-02、決定 84）。PRD（AC-116、AC-132）",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読書を終えました。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reading session ended."
          }
        }
      }
    },
    "result.summary.pages.first": {
      "comment": "S-4 の `result.summary`（前の場所がない本で初めてページを入れた晩。`%2$@` は `duration.minutes`）。足した（2026-11-02）。PRD（AC-76 の (2)）",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "p.%1$lld　%2$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "p.%1$lld  %2$@"
          }
        }
      }
    },
    "result.summary.locations.first": {
      "comment": "S-4 の `result.summary`（前の場所がない本で初めて位置番号を入れた晩）。足した（2026-11-02）。PRD（AC-76、AC-141）",
      "extractionState": "manual",
