      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すぐ読み始める（書名はあとで）"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start Reading Now (Add Title Later)"
          }
        }
