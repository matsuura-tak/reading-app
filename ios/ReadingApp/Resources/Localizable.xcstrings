            "value": "%lld / 140"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld / 140"
          }
        }
      }
    },
    "mark.ocr.guide": {
      "comment": "OCR結果の枠選択画面の案内文",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
