          "stringUnit": {
            "state": "translated",
            "value": "積読からすぐ読む"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read Next from Stack"
          }
        }
      }
    },
    "bookmark.noCurrent.choose": {
      "comment": "しおり画面の積読候補を1タップで今の本にするボタン",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これを読む"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read This"
          }
        }
      }
    },
    "bookmark.empty.title": {
      "comment": "本が1冊もない初回起動時の案内見出し",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読んでいる本を1冊、しおりに挟みましょう"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuck Your First Book into the Bookmark"
          }
        }
      }
    },
    "bookmark.empty.body": {
      "comment": "初回起動時の案内本文",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バーコードや表紙、書名からすぐ始められます"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start right away with a barcode, cover, or title"
          }
