    "duration.minutes": {
      "comment": "画面に出す読書時間はすべてこの形（1〜1440分。60分以上も「85分」「1440分」のまま）。S-4 の `result.summary`、W-3（`ended`）、S-7 の記録の行と `book.total`、S-9 の `finish.reflection.*` の分の値。PRD が分で指定している（AC-22 の合計「85分」、AC-57 の「1440分」、AC-127 の「142分」）ため、時間に直さない（2026-11-02 に「60分未満」の限定を外した。決定 82）。足した",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld分"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld min"
          }
        }
      }
    },
