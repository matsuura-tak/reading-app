        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't read text. Retake in brighter light or enter manually"
          }
        }
      }
    },
    "mark.camera.denied.title": {
      "comment": "カメラ権限が拒否されているときの見出し",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラが使えません"
