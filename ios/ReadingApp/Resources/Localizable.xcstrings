    "result.summary.spoken": {
      "comment": "S-4 の `result.summary` の読み上げ（`%1$@`・`%2$@` は `page.spoken` / `location.spoken` / `percent.spoken` の文、`%3$@` は `duration.minutes.spoken`）。例「43ページから61ページ、18分」／\"page 43 to page 61, 18 minutes\"。見える文字の「p.」を置き換えて作らない（決定 53）。足した（2026-11-02）。PRD（AC-75、AC-76、AC-141）",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@から%2$@、%3$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ to %2$@, %3$@"
          }
        }
      }
    },
    "result.summary.first.spoken": {
      "comment": "S-4 の `result.summary` の読み上げ（前の場所がない晩。例「61ページ、18分」）。`mark.later` の晩は `duration.minutes.spoken` だけを読む。足した（2026-11-02）。PRD（AC-75、AC-76）",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@、%2$@"
          }
        },
