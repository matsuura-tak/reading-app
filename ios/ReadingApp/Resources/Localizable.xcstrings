      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本を加える"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add Book"
          }
        }
      }
    },
    "bookmark.editMark": {
      "comment": "読書を始めずに今のしおり（ページ・一行）を編集するボタン",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "しおりを直す"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit Bookmark"
          }
        }
      }
    },
    "bookmark.noCurrent.title": {
      "comment": "今の本が未設定のときの案内見出し",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次に読む本を選びましょう"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose Your Next Book"
          }
        }
      }
    },
    "bookmark.noCurrent.body": {
      "comment": "今の本が未設定のときの案内本文",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本棚から選ぶか、新しい本を加えられます"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a book from your shelf or add a new one"
          }
        }
      }
    },
    "bookmark.noCurrent.openShelf": {
      "comment": "今の本が未設定のときに本棚を開くボタン",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本棚から選ぶ"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose from Shelf"
          }
        }
      }
    },
