            "state": "translated",
            "value": "%1$@, %2$@"
          }
        }
      }
    },
    "liveActivity.ended.summary": {
      "comment": "W-3（`ended`）の見える文字（`%1$@` は `duration.minutes`、`%2$@` は `page.short` / `location.short` / `percent.short`）。例「10分 · p.61」。場所がなければ `duration.minutes` だけ。足した（2026-11-02）。PRD（AC-41、AC-114）",
      "extractionState": "manual",
