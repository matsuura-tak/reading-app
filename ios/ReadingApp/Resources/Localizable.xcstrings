        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessions shorter than 1 minute aren't saved."
          }
        }
      }
    },
    "session.invalidTime": {
      "comment": "端末の時刻が巻き戻ったため記録しなかったときのバナー通知",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末の時刻が読み始めより前になっていたので、この読書は記録に残しませんでした。「設定」で日付と時刻を確かめてから、もう一度読み始めてください。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This session wasn't saved because the device's time was set earlier than when you started. Check the date and time in Settings, then start again."
          }
        }
      }
    },
    "session.capped": {
      "comment": "読書時間が24時間を超えたため上限で記録したときのバナー通知",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "24時間で数えるのを止めました。分数は、本の画面の記録で直せます。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Counting stopped at 24 hours. You can edit the minutes in the book's reading log."
          }
        }
      }
    },
