        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "(Untitled Book)"
          }
        }
      }
    },
    "bookmark.setBookTitle": {
      "comment": "書名未設定の今の本に後から書名・書誌を入れるボタン",
