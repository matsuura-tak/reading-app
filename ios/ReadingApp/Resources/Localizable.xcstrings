          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retake"
          }
        }
      }
    },
    "mark.ocr.empty": {
      "comment": "OCRで1行も検出できなかったときの案内文",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字が読み取れませんでした。明るい場所で撮り直すか、手で入力してください"
